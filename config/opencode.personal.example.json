{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "build": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "plan": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "general": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "explore": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "debug": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "review": {
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      "open-pencil": {
        "type": "local",
        "command": ["openpencil-mcp"]
      }
    }
  }
}
